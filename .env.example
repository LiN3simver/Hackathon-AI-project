# Local development only. Copy to .env; never commit actual credentials.
GUARDIAN_ENVIRONMENT=development
GUARDIAN_WEB_ORIGIN=https://localhost:5173
VITE_API_BASE_URL=/api/v1

# Set both values locally to create the first administrator in an empty database.
# Use a unique password with at least 12 characters. No accounts are bundled.
# Remove these values after the first successful startup.
GUARDIAN_BOOTSTRAP_ADMIN_USERNAME=
GUARDIAN_BOOTSTRAP_ADMIN_PASSWORD=

# Runtime storage is private and excluded from version control.
GUARDIAN_DATABASE_PATH=data/guardian.sqlite3
GUARDIAN_INSPECTION_STORAGE_PATH=data/inspection_images
GUARDIAN_ACTIVE_LEARNING_STORAGE_PATH=data/active_learning/images
GUARDIAN_INSPECTION_ANALYSIS_QUEUE_CAPACITY=50
GUARDIAN_LOG_DIRECTORY=logs
GUARDIAN_LOG_LEVEL=INFO

# Supply your own approved checkpoint and authorized datasets.
GUARDIAN_VIEW_MODEL_PATH=models/exterior_view_classifier.pt
GUARDIAN_COMPETITION_DATA_ROOT=
GUARDIAN_DATASET_SOURCE_ROOT=
GUARDIAN_SUPPLEMENTAL_PHOTO_ROOT=

# Optional local model server; model names must match your installation.
GUARDIAN_OLLAMA_BASE_URL=http://127.0.0.1:11434
GUARDIAN_OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
GUARDIAN_CLEANLINESS_VISION_MODEL=qwen3-vl:4b-instruct
GUARDIAN_OLLAMA_TIMEOUT_SECONDS=180
GUARDIAN_CLEANLINESS_LOCALIZATION_TIMEOUT_SECONDS=180
GUARDIAN_HISTORY_RAG_GENERATION_ENABLED=true
GUARDIAN_HISTORY_RAG_MODEL=
GUARDIAN_HISTORY_RAG_MAX_EVENTS=20
GUARDIAN_HISTORY_RAG_GENERATION_TIMEOUT_SECONDS=25
GUARDIAN_HISTORY_LLM_MODELS=[]
GUARDIAN_HISTORY_LLM_KEEP_ALIVE=30m
GUARDIAN_HISTORY_LLM_NUM_CTX=4096
GUARDIAN_HISTORY_LLM_NUM_THREAD=
GUARDIAN_HISTORY_LLM_QUEUE_SECONDS=5
GUARDIAN_HISTORY_LLM_WARMUP=false

# Keep operational automation advisory until independently validated.
GUARDIAN_AUTOMATION_ROUTING_ENABLED=true
GUARDIAN_AUTOMATION_SHADOW_MODE=true
GUARDIAN_AUTOMATION_AUTO_CLEAR_CONFIDENCE=0.95
GUARDIAN_AUTOMATION_AUTO_CASE_CONFIDENCE=0.90
GUARDIAN_AUTOMATION_POLICY_VERSION=automation-routing-v1

# Notifications require an explicitly configured private outbox and recipients.
GUARDIAN_NOTIFICATION_EMAIL_ENABLED=false
GUARDIAN_NOTIFICATION_EMAIL_RECIPIENT=
GUARDIAN_NOTIFICATION_CLEANING_EMAIL_RECIPIENT=
GUARDIAN_NOTIFICATION_MAX_ATTEMPTS=3
GUARDIAN_NOTIFICATION_RETRY_BASE_SECONDS=30
GUARDIAN_POWER_AUTOMATE_OUTBOX_PATH=

# Set an explicit HTTPS URL when opting in to phone access.
GUARDIAN_MOBILE_WEB_URL=
GUARDIAN_MOBILE_WEB_PORT=5173
